# Config Docker Compose du SOC central. Copie en .env et renseigne PLUME_PASS_HASH.
# Le mot de passe N'EST JAMAIS stocke en clair : on met SON HASH argon2id.
#   docker compose run --rm soc hashpw 'mon-mot-de-passe'   -> colle le $argon2id$... ci-dessous
PLUME_USER=admin
PLUME_PASS_HASH=
# host autorise (anti-DNS-rebinding). Derriere un reverse-proxy : mets le vrai domaine.
PLUME_HOST=soc.localhost
# DEMO : 1 = peuple une instance FRAICHE de donnees d'exemple (events/metrics/alertes) pour voir Plume
# vivant sans agent. NE PAS activer en prod. Defaut 0.
PLUME_DEMO=0
# DEMO PUBLIQUE (instance EXPOSEE sur Internet) : 1 = acces ANONYME en LECTURE SEULE (role viewer
# force ; ecriture/admin/ingest/mail bloques). A combiner avec PLUME_DEMO=1 et une instance ISOLEE
# (jamais le SOC reel). Defaut 0.
PLUME_PUBLIC_DEMO=0

# ---------------------------------------------------------------------------------------------
# CHIFFREMENT AT-REST (SQLCipher) -- OPT-IN
# ---------------------------------------------------------------------------------------------
# VIDE = la base est EN CLAIR sur le volume docker. SQLCipher est compile dans le binaire mais ne
# s'active QU'AVEC une cle. Une base neuve est alors creee chiffree d'office ; une base en clair
# existante est convertie au boot (idempotent).
# A DECIDER AVANT LE PREMIER DEMARRAGE, et PERTE DE CLE = PERTE DE LA BASE : gardez-la hors de
# cette machine. (En k3s/systemd, preferez PLUME_DB_KEY_FILE : un fichier monte en lecture seule,
# fail-closed s'il est absent -- une variable d'env reste lisible via /proc/<pid>/environ.)
# PLUME_DB_KEY et PLUME_DB_KEY_FILE se lisent dans l'environnement OU dans le fichier PLUME_CONFIG
# (/etc/plume/soc.conf sur un hote) ; l'environnement gagne. ATTENTION : une variable PRESENTE mais
# VIDE (la ligne ci-dessous telle quelle, si elle atteint l'environnement) vaut "aucune cle" et
# NEUTRALISE une valeur du fichier -- c'est la meme regle que pour tous les autres reglages.
PLUME_DB_KEY=

# ---------------------------------------------------------------------------------------------
# BACKUP NATIF (scheduler in-daemon) -- ACTIF par defaut dans le docker-compose.yml livre
# ---------------------------------------------------------------------------------------------
# Intervalle en SECONDES. 0 = DESACTIVE (aucun thread, aucun backup). 21600 = toutes les 6 h.
PLUME_BACKUP_INTERVAL=21600
# Retention KEEP-N : on garde les N archives les plus recentes (24 x 6 h ~ 6 jours).
PLUME_BACKUP_KEEP=24
# Repertoire LOCAL de destination (sur le volume soc-data). `s3://...` est DETECTE ET REFUSE
# (sink S3 natif non implemente) : le scheduler se desactive avec un log clair plutot que de
# produire un faux backup local.
PLUME_BACKUP_DEST=/data/backups
# 1 = un backup des le demarrage, en plus du cycle periodique.
PLUME_BACKUP_ON_START=0
# ESCROW HORS-HOTE : cle PUBLIQUE age (age1...). Ce n'est PAS un secret. Non posee -> repli sur le
# chiffrement SYMETRIQUE (passphrase = cle SQLCipher, presente sur l'hote) donc les archives sont
# DECHIFFRABLES PAR L'HOTE : pas d'escrow. Le daemon emet alors un evenement de posture
# non-purgeable (category=health, severite 4). Sans cle SQLCipher NI destinataire age, l'archive
# n'est pas chiffree du tout.
PLUME_BACKUP_AGE_RECIPIENT=
# 1 = REFUSER de produire un backup symetrique (exige un destinataire age asymetrique).
PLUME_BACKUP_REQUIRE_ASYMMETRIC=0
# FACTEUR DE TRAVAIL scrypt (log2 N) du chiffrement PAR PASSPHRASE, borne [10, 20]. Vide = 12, soit
# 4 194 304 octets de tampon. NE TOUCHEZ PAS SANS RAISON : ce chemin ne chiffre pas avec un mot de
# passe humain mais avec PLUME_DB_KEY, et le meme secret protege deja le tier froid a log_n=12 --
# monter ici ne releve donc AUCUN plancher, ca ne fait que consommer de la RAM sous le budget 2 Gio.
# La seule bonne raison de le relever : vous SAVEZ que votre PLUME_DB_KEY est une phrase tapee par
# un humain. Prix : 16 -> 67 108 864 octets, 20 -> 1 073 741 824 octets (mesures 2026-08-09).
# Historique : avant le 2026-08-09 age choisissait ce facteur AU CHRONOMETRE a chaque sauvegarde
# (19 et 20 mesures en release = 512 Mio a 1 Gio) ; plume relit ces archives-la jusqu'a log_n=20.
PLUME_BACKUP_SCRYPT_LOG_N=

# ---------------------------------------------------------------------------------------------
# OU CES VARIABLES SONT LUES -- CORRIGE le 2026-08-09 (P8.7-a)
# ---------------------------------------------------------------------------------------------
# Jusqu'au 2026-08-09, PLUME_BACKUP_AGE_RECIPIENT, PLUME_BACKUP_REQUIRE_ASYMMETRIC,
# PLUME_BACKUP_SCRYPT_LOG_N, PLUME_BACKUP_FORCE_PLAINTEXT_EXPORT, PLUME_BACKUP_STAGING_DIR et
# PLUME_BACKUP_AGE_IDENTITY[_FILE] etaient lues dans l'ENVIRONNEMENT du processus, JAMAIS dans
# /etc/plume/soc.conf -- alors que PLUME_BACKUP_INTERVAL/DEST/KEEP, elles, l'etaient. En systemd
# host-natif (ou `plume-daemon.service` ne porte aucun EnvironmentFile) un destinataire d'escrow
# ecrit dans soc.conf etait donc ignore EN SILENCE, et les archives repartaient en chiffrement
# symetrique -- dechiffrables par l'hote. Le garde fail-closed cense refuser ce cas etait muet pour
# la meme raison.
# DESORMAIS elles suivent TOUTES la meme precedence : env > fichier PLUME_CONFIG > defaut. Rien ne
# change pour docker-compose ni pour k3s (l'environnement gagne toujours, et PLUME_CONFIG y vaut
# /nonexistent) ; sur un hote, soc.conf est enfin honore. Si une cle change d'effet a cause de ca,
# le demon le DIT au demarrage, en la nommant.

# AUTO-VACUUM INCREMENTAL (reclaim non-bloquant). 0 = desactive ; 86400 = une passe/jour.
# INOPERANT (warn honnete, jamais de VACUUM plein bloquant) si la base n'est pas en
# auto_vacuum=INCREMENTAL -- verifiez avec `plume-daemon db-stats`.
PLUME_AUTOVACUUM_INTERVAL=86400
