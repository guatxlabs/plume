# Config Docker Compose du SOC central. Copie en .env et renseigne PLUME_PASS_HASH.
# Le mot de passe N'EST JAMAIS stocke en clair : on met SON HASH argon2id.
#   docker compose run --rm soc hashpw 'mon-mot-de-passe'   -> colle le $argon2id$... ci-dessous
PLUME_USER=admin
PLUME_PASS_HASH=
# host autorise (anti-DNS-rebinding). Derriere un reverse-proxy : mets le vrai domaine.
PLUME_HOST=soc.localhost
# DEMO : 1 = peuple une instance FRAICHE de donnees d'exemple (events/metrics/alertes) pour voir Plume
# vivant sans agent. NE PAS activer en prod. Defaut 0.
PLUME_DEMO=0
# DEMO PUBLIQUE (instance EXPOSEE sur Internet) : 1 = acces ANONYME en LECTURE SEULE (role viewer
# force ; ecriture/admin/ingest/mail bloques). A combiner avec PLUME_DEMO=1 et une instance ISOLEE
# (jamais le SOC reel). Defaut 0.
PLUME_PUBLIC_DEMO=0
