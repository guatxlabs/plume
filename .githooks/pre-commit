#!/usr/bin/env bash
_r="$(git rev-parse --show-toplevel)"
"$_r/.github/scripts/verifier-identite.sh" --index || exit 1
# P8.5-a — LA MESURE REVIENT LÀ OÙ LA DÉCISION SE PREND.
#
# POURQUOI UN HOOK ET PAS UN DÉCLENCHEUR DE CI DE PLUS. `ci.yml` s'exécute DÉJÀ sur
# `push: branches: ["**"]` (depuis sa création — le bloc `on:` n'a jamais changé) et tous les
# commits sont poussés. La garde `EXPECTED_TESTS` a donc bel et bien tourné, et bel et bien vu la
# dérive 937 -> 945 du 2026-08-07. Ce qui a manqué n'est pas une exécution de plus, c'est de LIRE
# son verdict avant de recommencer. Un rouge sur une page qu'on n'ouvre pas ne fait rien changer.
#
# CE QU'IL COÛTE — ET IL COÛTE UNE COMPILATION (P8.9-e). Le script délégué n'EXÉCUTE aucun test,
# mais pour les ÉNUMÉRER il fait CONSTRUIRE le harnais par cargo. Un commit qui déclenche ce hook
# paie donc une compilation, prend le verrou du répertoire d'artefacts, et entre en concurrence
# avec toute construction déjà en cours. RE-MESURÉ LE 2026-08-27 (12 cœurs, `target/` peuplé) :
#     commit ne touchant QUE le compteur dans `ci.yml`  : 1 s  (rien à reconstruire)
#     commit touchant UN fichier de `daemon/src/`       : 34 s (les deux suites ; 17 s en `--defaut`)
#     `target/` froid (clone frais)                     : une construction complète
# Contre ~47 min pour EXÉCUTER les deux suites. Le chiffre « ~2 s » qui figurait ici datait du
# 2026-08-09 et décrivait un arbre INCHANGÉ — or ce hook ne se déclenche QUE quand le démon ou son
# compteur a changé, donc presque jamais dans cet état-là. Il ne se déclenche pas du tout sur un
# commit de ROADMAP ou de manifeste : celui-là ne paie rien.
#
# UNE SEULE CONSTRUCTION À LA FOIS, ET RIEN PENDANT UNE SUITE : le script sonde le répertoire
# d'artefacts et REFUSE (code 3) si une construction tourne déjà, plutôt que d'en mettre une seconde
# en file — auquel cas cargo attendait sans limite, et sans un mot, sa ligne d'attente étant jetée
# avec stderr. Depuis `P8.27-h` il refuse AUSSI si une SUITE DE TESTS tourne : le verrou d'artefacts
# ne dit rien de celle-là (MESURÉ : il est libre pendant toute son exécution), et compiler pendant
# qu'elle tourne fausse les témoins qui mesurent une crête mémoire.
#
# POUR ATTENDRE AU LIEU DE REFUSER : `COMPTER_ATTENDRE=1 git commit …`. LA LIGNE QUI FIGURAIT ICI
# DISAIT « --attendre », ET C'ÉTAIT UN GESTE QUI N'EXISTAIT PAS (mesuré le 2026-08-29) : git ne
# passe AUCUN argument à un crochet de pré-commit, et ce fichier appelle le script par `exec` sans
# `"$@"`. Lancer le script à part avec `--attendre` ne referme pas la boucle non plus, puisque le
# crochet re-sonde et re-refuse si l'occupation dure. C'est la famille de défaut « phrase vraie qui
# laisse croire le contraire » que `P8.9-e` a fermée sur ce même fichier — rejouée sur les deux
# lignes que le lot précédent avait retouchées pour cette raison.
#
# INSTALLATION (une fois par clone, non versionnable autrement — git n'installe jamais de hook seul) :
#     git config core.hooksPath .githooks
# CONTOURNEMENT ASSUMÉ : `git commit --no-verify`. Le hook est une boucle de retour, pas une
# frontière de sécurité — la frontière reste la CI, qui exécute vraiment les suites.
set -euo pipefail

racine="$(git rev-parse --show-toplevel)"

# ── IDENTITÉ PUBLIQUE ───────────────────────────────────────────────────────────────────
# CE QUI S'EST PASSÉ. L'identité git GLOBALE de la machine de développement est un compte
# GitHub PERSONNEL. Tout dépôt sans réglage LOCAL en hérite, et un `git clone` frais perd
# la config locale : c'est ainsi que l'historique public a fini avec deux auteurs pour une
# seule personne.
#
# POURQUOI PAS DANS `.mailmap`. Un `.mailmap` a été essayé puis RETIRÉ : il ne change pas la
# page « Contributors » de GitHub, qui apparie les commits à des comptes par leur ADRESSE —
# vérifié, l'ancien compte y figurait toujours. Garder un fichier qui ne tient pas sa promesse
# est pire que ne pas l'avoir.
#
# `P8.9-n` — LE CONTRÔLE VIT DANS LE FICHIER QUI POSSÈDE LE CANONIQUE, ET IL Y EST APPELÉ
# DÈS LA LIGNE 3. Ce hook portait ici une SECONDE copie du littéral, sous un commentaire qui
# affirmait que le canonique n'avait qu'un seul lieu — pendant que le script délégué, appelé
# 55 lignes plus haut, affirmait la même chose de lui-même. Deux fichiers revendiquaient
# d'être l'endroit unique, et la phrase était donc fausse aux deux endroits.
#
# CE QUI A ÉTÉ DÉPLACÉ, ET POURQUOI CE N'ÉTAIT PAS UNE REDONDANCE (mesuré le 2026-09-03) :
# la copie d'ici lisait l'identité EFFECTIVE (`git var GIT_AUTHOR_IDENT`), là où le script
# ne lisait que la CONFIGURATION. Avec `GIT_AUTHOR_NAME` dans l'environnement, la config
# reste canonique et le script ACCEPTAIT un commit qui serait parti sous un autre nom. Le
# contrôle fort n'a donc pas été supprimé : il a rejoint le canonique, qui est désormais
# écrit une seule fois, à un seul endroit, et c'est vérifiable.
#
# CE N'EST PAS UNE FRONTIÈRE DE SÉCURITÉ : `--no-verify` la contourne, et c'est assumé. La
# frontière est la CI, qui rejoue la même vérification sur la plage poussée.

# PORTÉE DÉRIVÉE DU DIFF, PAS D'UNE LISTE À TENIR : seuls les commits qui touchent au code ou au
# verrou de dépendances d'une caisse compilée peuvent déplacer un compte de tests.
#
# TROU FERMÉ LE 2026-08-10, trouvé en éprouvant ce hook au lieu de le croire. La portée ne
# couvrait QUE `daemon/` — donc éditer le compteur DANS `ci.yml` seul (faute de frappe, mauvaise
# fusion, chiffre recopié à la main) passait sans contrôle, alors que c'est précisément là que le
# chiffre vit. Mesuré : `EXPECTED_TESTS` faussé de 1007 à 999, `ci.yml` seul indexé -> hook rc=0,
# aucune sortie. Le même diff avec un vrai changement dans `daemon/src/` -> rc=1, dérive nommée.
# La portée couvre donc les DEUX faces : ce qui peut déplacer le compte, ET ce qui le DÉCLARE.
#
# SECOND TROU, MESURÉ LE 2026-08-30 (`P8.9-m`) — LA PORTÉE ÉTAIT BORNÉE À UNE CAISSE SUR QUATRE.
# `daemon/` et `ci.yml` étaient écrits en dur, alors que l'intégration continue fait respecter CINQ
# compteurs (`EXPECTED_TESTS`, `EXPECTED_COLD_TESTS`, `EXPECTED_S3_TESTS`, `EXPECTED_SYSLOG_TESTS`,
# `EXPECTED_MAIL_TESTS`) sur quatre caisses. Conséquence exacte : un test ajouté à `collector-syslog`
# ou à `collector-mail` laissait ce crochet MUET, et la CI ROUGE — la boucle de retour se refermait
# quinze minutes plus tard, sur une page qu'on n'ouvre pas. C'est le défaut que ce fichier raconte.
#
# CE QUI EST CORRIGÉ, ET CE QUI NE PEUT PAS L'ÊTRE ICI. La portée est désormais DÉRIVÉE : toute
# caisse découverte (`<caisse>/Cargo.toml` + `<caisse>/src/`) et tout workflow qui PORTE un compteur.
# Mais le script délégué (`compter-les-tests.sh`) ne sait énumérer que les deux suites du démon —
# ce n'est pas une liste à corriger ici, c'est la portée d'un autre fichier. Faire tourner ce
# délégué sur un commit de collecteur rendrait un VERT qui ne mesure rien : un aveu trop OPTIMISTE
# est bien pire qu'un aveu trop prudent. Ce crochet AVOUE donc, nommément, ce qu'il ne compte pas,
# au lieu de sortir 0 en silence comme il le faisait. La descente de ce reste est une seule chose :
# apprendre à `compter-les-tests.sh` les compteurs qu'il ne lit pas encore.
racine_git="$racine"

# Les caisses, DÉCOUVERTES (même dérivation que le pas `cargo-deny` de ci.yml) et les workflows qui
# PORTENT un compteur. Rien n'est écrit : une caisse ou un workflow neuf entre par construction.
caisses="$(cd "$racine_git" && find . -mindepth 2 -maxdepth 2 -name Cargo.toml -not -path './target/*' \
           | sed 's|^\./||; s|/Cargo\.toml$||' | sort -u)"
flux_porteurs="$(cd "$racine_git" && grep -lE '^[[:space:]]*EXPECTED_[A-Z0-9_]*TESTS?:[[:space:]]*"?[0-9]+"?[[:space:]]*$' \
                 .github/workflows/*.yml 2>/dev/null | sort -u)"

# PLANCHER DE NON-DÉGÉNÉRESCENCE : une découverte qui ne rend rien laisserait ce crochet inerte, et
# « aucun contrôle » se lirait comme « rien à contrôler ». Mesuré le 2026-08-30 : 4 caisses, 1 flux.
if [ -z "$caisses" ] || [ -z "$flux_porteurs" ]; then
    echo "[pre-commit] REFUS : découverte cassée (caisses='$caisses', flux='$flux_porteurs')." >&2
    echo "             Ce crochet ne saurait pas quoi contrôler ; il le dit au lieu de laisser passer." >&2
    exit 2
fi

motif="$(printf '%s\n' $caisses | sed 's|$|/(src/\|Cargo\\.(toml\|lock)$)|' ; \
         printf '%s\n' $flux_porteurs | sed 's|\.|\\.|g; s|$|$|')"
motif="^($(printf '%s' "$motif" | paste -sd'|' -))"

touches="$(git diff --cached --name-only | grep -E "$motif" || true)"
if [ -z "$touches" ]; then
    exit 0
fi

# CE QUE LE DÉLÉGUÉ SAIT COMPTER, DÉRIVÉ DE LUI, et ce que la CI fait respecter, dérivé des flux.
# L'ÉCART est exactement l'angle mort, et il est NOMMÉ à chaque déclenchement.
# Un compteur VIVANT est reconnu à la FORME qui le rend exécutoire — `NOM: "<nombre>"` seul sur sa
# ligne —, pas à la simple mention de son nom. Sans cette rigueur, l'alias
# `EXPECTED_DEFAULT_TESTS: ${{ env.EXPECTED_TESTS }}` entrait dans la liste et cet aveu nommait un
# compteur qui n'existe pas : un aveu FAUX vaut à peine mieux qu'un silence.
compteurs_ci="$(cd "$racine_git" && grep -hE '^[[:space:]]*EXPECTED_[A-Z0-9_]*TESTS?:[[:space:]]*"?[0-9]+"?[[:space:]]*$' $flux_porteurs \
                | grep -oE 'EXPECTED_[A-Z0-9_]*TESTS?' | sort -u || true)"
# Côté délégué, les COMMENTAIRES sont exclus : compter une simple mention en prose comme une
# couverture RÉTRÉCIRAIT le trou avoué. En cas de doute, cet aveu doit SUR-estimer le trou.
compteurs_delegue="$(grep -vE '^[[:space:]]*#' "$racine/.github/scripts/compter-les-tests.sh" \
                     | grep -oE 'EXPECTED_[A-Z0-9_]*TESTS?' | sort -u || true)"
non_couverts="$(comm -23 <(printf '%s\n' "$compteurs_ci") <(printf '%s\n' "$compteurs_delegue") | paste -sd' ' -)"
compteurs_delegue_ligne="$(printf '%s\n' "$compteurs_delegue" | paste -sd' ' -)"

# Les caisses touchées que le délégué ne sait pas compter : il ne connaît que celle dont il énumère
# les suites, et c'est LUI qui le dit (il `cd` dedans). Aucune liste n'est écrite ici non plus.
# LE MOTIF SUIT LE `cd`, ET C'EST UNE CORRECTION MESURÉE DU 2026-08-30. Un premier jet cherchait un
# guillemet FERMANT entre `racine` et la barre — une forme que le délégué N'EMPLOIE PAS : il écrit
# `cd "$racine/daemon"`, guillemet AVANT le `$`. La dérivation ne rendait donc RIEN, et le crochet
# refusait de conclure sur CHAQUE commit. Un refus est le bon comportement quand la mesure manque,
# mais un refus PERMANENT est une RANÇON : aucun geste ne pouvait le lever. Le motif suit désormais
# le geste que le commentaire ci-dessus déclare — le `cd` —, ce qui le rend aussi plus ÉTROIT :
# une occurrence quelconque de `$racine/<minuscule>` ailleurs dans le délégué ne le trompe plus.
caisse_du_delegue="$(grep -oE 'cd "\$racine/[a-z][a-z0-9-]*' "$racine/.github/scripts/compter-les-tests.sh" \
                     | sed 's|.*/||' | sort -u | head -1 || true)"
if [ -z "$caisse_du_delegue" ]; then
    echo "[pre-commit] REFUS : impossible de dériver la caisse que compter-les-tests.sh sait énumérer." >&2
    echo "             Sans elle, ce crochet ne saurait ni contrôler ni avouer honnêtement." >&2
    exit 2
fi
for c in $caisses; do
    [ "$c" = "$caisse_du_delegue" ] && continue
    if printf '%s\n' "$touches" | grep -qE "^$c/"; then
        echo "[pre-commit] AVEU : \`$c/\` est touché, et ce crochet NE SAIT PAS compter sa suite."
        echo "[pre-commit]        Le délégué .github/scripts/compter-les-tests.sh ne connaît que"
        echo "[pre-commit]        \`$caisse_du_delegue\` ($compteurs_delegue_ligne)."
        echo "[pre-commit]        Compteurs vivants que ce crochet ne sait PAS vérifier (tous flux"
        echo "[pre-commit]        confondus — l'appariement compteur/caisse n'est pas dérivé ici) :"
        echo "[pre-commit]          ${non_couverts:-(aucun)}"
        echo "[pre-commit]        Un test ajouté ici sera vu par l'intégration continue, pas par vous"
        echo "[pre-commit]        maintenant. RIEN n'est vérifié pour cette caisse — ne lisez pas le"
        echo "[pre-commit]        silence qui suit comme un feu vert."
    fi
done

# Et le contrôle qui EXISTE vraiment : celui du délégué, sur la caisse qu'il sait énumérer.
if ! printf '%s\n' "$touches" \
     | grep -qE "^($caisse_du_delegue/(src/|Cargo\.(toml|lock)$)|$(printf '%s' "$flux_porteurs" | sed 's|\.|\\.|g' | paste -sd'|' -))$|^$caisse_du_delegue/src/"; then
    exit 0
fi

echo "[pre-commit] $caisse_du_delegue ou compteur touché -> vérification du compte de tests."
echo "[pre-commit] ATTENTION : ce contrôle CONSTRUIT (aucun test n'est exécuté, mais le harnais est"
echo "[pre-commit] compilé pour être énuméré). Il refuse si une construction OU une suite de tests"
echo "[pre-commit] tourne déjà — un refus dit lequel, et le geste qu'il faut."
echo "[pre-commit] Pour attendre au lieu de refuser :  COMPTER_ATTENDRE=1 git commit …"
echo "[pre-commit] Pour ne pas contrôler du tout      :  git commit --no-verify"
exec "$racine/.github/scripts/compter-les-tests.sh"
