#!/usr/bin/env bash
_r="$(git rev-parse --show-toplevel)"
"$_r/.github/scripts/verifier-identite.sh" --index || exit 1
# P8.5-a — LA MESURE REVIENT LÀ OÙ LA DÉCISION SE PREND.
#
# POURQUOI UN HOOK ET PAS UN DÉCLENCHEUR DE CI DE PLUS. `ci.yml` s'exécute DÉJÀ sur
# `push: branches: ["**"]` (depuis sa création — le bloc `on:` n'a jamais changé) et tous les
# commits sont poussés. La garde `EXPECTED_TESTS` a donc bel et bien tourné, et bel et bien vu la
# dérive 937 -> 945 du 2026-08-07. Ce qui a manqué n'est pas une exécution de plus, c'est de LIRE
# son verdict avant de recommencer. Un rouge sur une page qu'on n'ouvre pas ne fait rien changer.
#
# CE QU'IL COÛTE, MESURÉ LE 2026-08-09 : ~2 s quand `target/` est déjà dans le bon jeu de features,
# jusqu'à ~46 s s'il doit rebasculer entre le profil par défaut et `cold_tier`. Contre 47 minutes
# pour exécuter les deux suites. Et il ne se déclenche QUE si le commit touche le démon — un commit
# de ROADMAP ou de manifeste ne paie rien du tout.
#
# INSTALLATION (une fois par clone, non versionnable autrement — git n'installe jamais de hook seul) :
#     git config core.hooksPath .githooks
# CONTOURNEMENT ASSUMÉ : `git commit --no-verify`. Le hook est une boucle de retour, pas une
# frontière de sécurité — la frontière reste la CI, qui exécute vraiment les suites.
set -euo pipefail

racine="$(git rev-parse --show-toplevel)"

# ── IDENTITÉ PUBLIQUE ───────────────────────────────────────────────────────────────────
# CE QUI S'EST PASSÉ. L'identité git GLOBALE de la machine de développement est un compte
# GitHub PERSONNEL. Tout dépôt sans réglage LOCAL en hérite, et un `git clone` frais perd
# la config locale : c'est ainsi que l'historique public a fini avec deux auteurs pour une
# seule personne.
#
# POURQUOI LE CANONIQUE EST ÉCRIT ICI ET PLUS DANS `.mailmap`. Un `.mailmap` a été essayé
# puis RETIRÉ : il ne change pas la page « Contributors » de GitHub, qui apparie les
# commits à des comptes par leur ADRESSE — vérifié, l'ancien compte y figurait toujours.
# Garder un fichier qui ne tient pas sa promesse est pire que ne pas l'avoir. La garde,
# elle, tient : elle empêche le PROCHAIN commit de partir sous la mauvaise identité. Son
# canonique vit donc ici, à un seul endroit, dans le seul fichier qui le consomme.
#
# CE N'EST PAS UNE FRONTIÈRE DE SÉCURITÉ : `--no-verify` la contourne, et c'est assumé.
CANONIQUE="guatxlabs <noreply@guatx.com>"
actuel="$(git var GIT_AUTHOR_IDENT | sed 's/ [0-9]\{9,\} [+-][0-9]\{4\}$//')"
if [ "$actuel" != "$CANONIQUE" ]; then
    echo "[pre-commit] REFUS : ce commit partirait sous « $actuel »." >&2
    echo "             Ce dépôt public publie sous « $CANONIQUE »." >&2
    echo "             Cause la plus fréquente : la config git GLOBALE de la machine, héritée" >&2
    echo "             faute de réglage local — un clone frais y retombe systématiquement." >&2
    echo "             Geste :  git config user.name guatxlabs && git config user.email noreply@guatx.com" >&2
    exit 1
fi

# PORTÉE DÉRIVÉE DU DIFF, PAS D'UNE LISTE À TENIR : seuls les commits qui touchent au code ou au
# verrou de dépendances du démon peuvent déplacer le compte de tests.
#
# TROU FERMÉ LE 2026-08-10, trouvé en éprouvant ce hook au lieu de le croire. La portée ne
# couvrait QUE `daemon/` — donc éditer le compteur DANS `ci.yml` seul (faute de frappe, mauvaise
# fusion, chiffre recopié à la main) passait sans contrôle, alors que c'est précisément là que le
# chiffre vit. Mesuré : `EXPECTED_TESTS` faussé de 1007 à 999, `ci.yml` seul indexé -> hook rc=0,
# aucune sortie. Le même diff avec un vrai changement dans `daemon/src/` -> rc=1, dérive nommée.
# La portée couvre donc les DEUX faces : ce qui peut déplacer le compte, ET ce qui le DÉCLARE.
if ! git diff --cached --name-only \
     | grep -qE '^(daemon/(src/|Cargo\.(toml|lock)$)|\.github/workflows/ci\.yml$)'; then
    exit 0
fi

echo "[pre-commit] démon ou compteur touché -> vérification du compte de tests (aucun test exécuté)"
exec "$racine/.github/scripts/compter-les-tests.sh"
