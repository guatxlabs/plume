# Corpus DIFFÉRENTIEL de collectors/auditd.sh (P10.32-k). Lu par .github/scripts/check_a_live_sensor_never_reads_as_mute_or_calm.py.
# Les lignes qui commencent par `#` sont retirées avant d'écrire le journal simulé ; tout le reste est écrit tel quel.
# Chaque enregistrement a la FORME qu'écrit auditd (`type=… msg=audit(<s>.<ms>:<série>): …`) ; noms, chemins et adresses
# sont d'exemple (adresse RFC 5737). Le fichier `auditd-differentiel.attendu.json` porte la sortie que l'ANCIENNE
# construction (boucle shell par événement) rendait sur ce corpus : la nouvelle doit la rendre à l'octet près.
# DÉFAUT HÉRITÉ, FIGÉ ICI À DESSEIN : dans un enregistrement SYSCALL, `val("uid")` prend la première sous-chaîne `uid=`,
# qui est celle de `auid=` — le champ `uid` des événements exec et tamper y vaut donc l'auid. L'attendu le reproduit
# (identité ancienne/nouvelle) ; le corriger relève de sa propre clé et changera cet attendu.
#
# exec réussi d'une session utilisateur (execve 64 bits), avec ses enregistrements compagnons
type=SYSCALL msg=audit(1758650000.101:5001): arch=c000003e syscall=59 success=yes exit=0 a0=55d0 a1=55d1 a2=55d2 a3=0 items=2 ppid=900 pid=901 auid=1000 uid=1002 gid=1002 euid=1002 suid=1002 fsuid=1002 egid=1002 sgid=1002 fsgid=1002 tty=pts0 ses=3 comm="ls" exe="/usr/bin/ls" subj=unconfined key="exec_tracking"
type=EXECVE msg=audit(1758650000.101:5001): argc=2 a0="ls" a1="-l"
type=CWD msg=audit(1758650000.101:5001): cwd="/home/exemple"
type=PATH msg=audit(1758650000.101:5001): item=0 name="/usr/bin/ls" inode=1201 dev=fd:00 mode=0100755 ouid=0 ogid=0 rdev=00:00 nametype=NORMAL cap_fp=0 cap_fi=0 cap_fe=0 cap_fver=0
type=PATH msg=audit(1758650000.101:5001): item=1 name="/lib64/ld-linux-x86-64.so.2" inode=1202 dev=fd:00 mode=0100755 ouid=0 ogid=0 rdev=00:00 nametype=NORMAL cap_fp=0 cap_fi=0 cap_fe=0 cap_fver=0
type=PROCTITLE msg=audit(1758650000.101:5001): proctitle=6C73002D6C
# exec ÉCHOUÉ
type=SYSCALL msg=audit(1758650000.202:5002): arch=c000003e syscall=59 success=no exit=-2 a0=55e0 a1=55e1 a2=55e2 a3=0 items=1 ppid=900 pid=902 auid=1000 uid=1000 gid=1000 euid=1000 suid=1000 fsuid=1000 egid=1000 sgid=1000 fsgid=1000 tty=pts0 ses=3 comm="bash" exe="/usr/bin/bash" subj=unconfined key="exec_tracking"
# exec d'un compte de SERVICE (auid non défini, clé svc_exec)
type=SYSCALL msg=audit(1758650000.303:5003): arch=c000003e syscall=59 success=yes exit=0 a0=55f0 a1=55f1 a2=55f2 a3=0 items=2 ppid=700 pid=703 auid=4294967295 uid=33 gid=33 euid=33 suid=33 fsuid=33 egid=33 sgid=33 fsgid=33 tty=(none) ses=4294967295 comm="sh" exe="/usr/bin/dash" subj=unconfined key="svc_exec"
# execveat (322), clé d'escalade de privilège
type=SYSCALL msg=audit(1758650000.404:5004): arch=c000003e syscall=322 success=yes exit=0 a0=3 a1=5600 a2=5601 a3=5602 items=2 ppid=900 pid=904 auid=1000 uid=0 gid=0 euid=0 suid=0 fsuid=0 egid=0 sgid=0 fsgid=0 tty=pts0 ses=3 comm="sudo" exe="/usr/bin/sudo" subj=unconfined key="priv_esc"
# exec sans clé
type=SYSCALL msg=audit(1758650000.505:5005): arch=c000003e syscall=59 success=yes exit=0 a0=5610 a1=5611 a2=5612 a3=0 items=2 ppid=1 pid=905 auid=0 uid=0 gid=0 euid=0 suid=0 fsuid=0 egid=0 sgid=0 fsgid=0 tty=(none) ses=1 comm="date" exe="/usr/bin/date" subj=unconfined key=(null)
# candidats au filtre EXEC-DROP : palier 1 (date), palier 2 (grep), hors préfixe standard, autre auid, échec, svc_exec
