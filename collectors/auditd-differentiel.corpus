type=SYSCALL msg=audit(1758650001.030:5012): arch=c000003e syscall=59 success=yes exit=0 a0=5680 a1=5681 a2=5682 a3=0 items=2 ppid=1 pid=912 auid=4294967295 uid=0 gid=0 euid=0 suid=0 fsuid=0 egid=0 sgid=0 fsgid=0 tty=(none) ses=4294967295 comm="cron" exe="/usr/sbin/cron" subj=unconfined key="exec_tracking"
