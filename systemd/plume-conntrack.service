[Unit]
Description=plume collector — connexions sortantes etablies (egress) -> events
# OPT-IN : installe mais non active par defaut. Activer : systemctl enable --now plume-conntrack.timer

[Service]
Type=oneshot
Environment=PLUME_SPOOL=/var/lib/plume/spool
Environment=PLUME_STATE=/var/lib/plume/state
ExecStart=/usr/local/lib/plume/collectors/conntrack.sh

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/plume/spool /var/lib/plume/state
# Familles d'adresses = ce que le script appelle (P10.33-d, dérivé par check_an_installation_is_hardened_in_every_mode.py) :
# ss = AF_NETLINK (sock_diag) ; getent hosts (rDNS) = requête DNS, AF_INET/AF_INET6.
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
LockPersonality=true
MemoryMax=64M
CPUQuota=20%
Nice=12
