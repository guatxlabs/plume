[Unit]
Description=plume collector — Control Catalog (contrôles de défense présents/vivants)
After=docker.service

[Service]
Type=oneshot
Environment=PLUME_SPOOL=/var/lib/plume/spool
ExecStart=/usr/local/lib/plume/collectors/controls.sh

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/plume/spool
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
# Familles d'adresses = ce que le script appelle (P10.33-d, dérivé par check_an_installation_is_hardened_in_every_mode.py) :
# systemctl (D-Bus, AF_UNIX) et sysctl (/proc/sys) : aucun socket réseau ni netlink.
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryMax=64M
CPUQuota=20%
Nice=10
IOSchedulingClass=idle
