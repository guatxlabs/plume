[Unit]
Description=plume collector — accès données (Varonis-like) auditd plume_data/plume_etc/plume_creds -> events source=dataaccess
After=auditd.service
# OPT-IN : installé mais NON activé. Activer : systemctl enable --now plume-dataaccess.timer
# Pré-requis : règles auditd plume_data/plume_etc/plume_creds chargées (cf plume-audit.rules + augenrules).

[Service]
Type=oneshot
Environment=PLUME_SPOOL=/var/lib/plume/spool
Environment=PLUME_STATE=/var/lib/plume/state
ExecStart=/usr/local/lib/plume/collectors/dataaccess.sh

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/plume/spool /var/lib/plume/state
CapabilityBoundingSet=CAP_AUDIT_READ CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_AUDIT_READ CAP_DAC_READ_SEARCH
RestrictAddressFamilies=AF_UNIX AF_NETLINK
LockPersonality=true
MemoryMax=128M
CPUQuota=30%
Nice=12
IOSchedulingClass=idle
