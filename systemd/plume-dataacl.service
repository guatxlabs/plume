[Unit]
Description=plume collector — carte d'accès données (Varonis) : perms/owner des chemins sensibles -> source=dataacl
After=local-fs.target
# OPT-IN : installé mais NON activé. Activer : systemctl enable --now plume-dataacl.timer

[Service]
Type=oneshot
EnvironmentFile=-/etc/plume/plume.conf
Environment=PLUME_SPOOL=/var/lib/plume/spool
Environment=PLUME_STATE=/var/lib/plume/state
ExecStart=/usr/local/lib/plume/collectors/dataacl.sh

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/plume/spool /var/lib/plume/state
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
RestrictAddressFamilies=AF_UNIX AF_NETLINK
LockPersonality=true
MemoryMax=128M
CPUQuota=20%
Nice=15
IOSchedulingClass=idle
