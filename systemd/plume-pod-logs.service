[Unit]
Description=plume collector — logs pods k8s filtrés (sécurité) -> events

[Service]
Type=oneshot
Environment=PLUME_SPOOL=/var/lib/plume/spool
Environment=PLUME_STATE=/var/lib/plume/state
# Debruitage : excluez les pods qui ont deja un collecteur DEDIE (p.ex. mail=mail.sh, moteurs de ban=bans.sh,
# argocd=kube-*) -> pas de double ingestion ; et ne shippe que sev>=3 (denied/unauthorized/fatal/panic).
Environment=PLUME_POD_LOG_SKIP=mailserver|crowdsec|fail2ban|argocd
Environment=PLUME_POD_LOG_MIN_SEV=1
ExecStart=/usr/local/lib/plume/collectors/pod-logs.sh

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/plume/spool /var/lib/plume/state
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryMax=128M
CPUQuota=30%
Nice=15
IOSchedulingClass=idle
