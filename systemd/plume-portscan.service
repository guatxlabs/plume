[Unit]
Description=plume collector — port-scan (table nft plume-portscan, log PORTSCAN) -> events/metrics
# OPT-IN : installé mais NON activé. Activer : systemctl enable --now plume-portscan.timer
# Lecture seule. Mode-aware : skip propre si nft / table plume-portscan absent.

[Service]
Type=oneshot
EnvironmentFile=-/etc/plume/plume.conf
Environment=PLUME_SPOOL=/var/lib/plume/spool
ExecStart=/usr/local/lib/plume/collectors/portscan.sh

NoNewPrivileges=true
# 'full' (pas 'strict') : nft/journalctl peut avoir besoin d'écrire son verrou dans /run.
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/plume
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
MemoryMax=96M
CPUQuota=20%
Nice=15
