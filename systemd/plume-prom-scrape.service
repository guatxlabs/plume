[Unit]
Description=plume collector — scrape Prometheus (/metrics) -> plume (OBS-1)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/plume/prom.conf
ExecStart=/usr/local/lib/plume/collectors/prom-scrape.sh

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryMax=128M
CPUQuota=30%
Nice=12
